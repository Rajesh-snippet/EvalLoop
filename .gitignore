```gitignore
# ============================================
# EvalLoop - Git Ignore
# ============================================

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# -----------------------------
# Virtual environments
# -----------------------------
.venv/
venv/
env/
ENV/
.env/
.venv.bak/

# -----------------------------
# Environment / Secrets
# -----------------------------
.env
.env.*
!.env.example

# API keys / credentials
*.key
*.pem
secrets/
credentials/


# -----------------------------
# ML / Embeddings / Models
# -----------------------------
models/
checkpoints/
embeddings/
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx

#

# -----------------------------
# Type checking / Linters
# -----------------------------
.mypy_cache/
.pyright/
.ruff_cache/

# -----------------------------
# IDEs / Editors
# -----------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# Keep VS Code project settings if needed
# !.vscode/settings.json

# -----------------------------
# OS generated files
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini

